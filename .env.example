# ==============================================================================
# GraphShield Enterprise Security Configuration Template (.env.example)
# Copy this file to .env and set secure production values before deployment.
# ==============================================================================

# System Environment (development | staging | production)
GRAPHSHIELD_ENV=development

# Cryptographic Keys (Must be high-entropy 256-bit hex strings in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GRAPHSHIELD_SECRET_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
GRAPHSHIELD_SALT_KEY=7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069
GRAPHSHIELD_HMAC_AUDIT_KEY=9b71d224bd62f3785d96d46ad3ea3d73319bfbc2890caadae2dff72519673ca7

# Role-Based API Authentication Keys
GRAPHSHIELD_ADMIN_API_KEY=gs_admin_sec_994821a8f01b3c2e
GRAPHSHIELD_ANALYST_API_KEY=gs_analyst_sec_410294b6d92a1e0f

# Rate Limiting & Denial of Service (DoS) Protection
RATE_LIMIT_PER_MINUTE=120
MAX_PAYLOAD_SIZE_BYTES=1048576  # 1 MB maximum payload limit

# Model & Pipeline Integrity
MODEL_INTEGRITY_CHECK_ENABLED=true
EXPECTED_MODEL_SHA256=d8e8fca2dc0f896fd7cb4cb0031ba249

# Data Privacy & Anonymization
ENABLE_SALTED_TOKENIZATION=true
MASK_PII_IN_LOGS=true

# Alert Threshold & Drift
DEFAULT_ALERT_THRESHOLD=0.50
DRIFT_DETECTION_P_VAL=0.01

